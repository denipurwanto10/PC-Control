# Telegram Remote Controller — salin file ini menjadi `.env` lalu isi.
# JANGAN commit `.env` ke GitHub (sudah ada di .gitignore).
#
# 1. Buat bot via @BotFather di Telegram -> /newbot -> salin token.
# 2. Cari tahu Telegram user ID kamu via @userinfobot -> kirim /start.
# 3. Isi di bawah ini (boleh beberapa ID, pisahkan koma):
#
# Contoh:
#   TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TELEGRAM_ALLOWED_USER_ID=123456789,987654321
#
# Kosong = Telegram nonaktif (hand gesture + voice tetap jalan normal).

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
